#!/bin/sh
# VoxEx pre-commit gate — enable once per clone with:
#   git config core.hooksPath .githooks
# Runs the fast headless checks (seconds). Skip in an emergency with:
#   git commit --no-verify        (or VOXEX_SKIP_HOOKS=1)
[ -n "$VOXEX_SKIP_HOOKS" ] && exit 0

fail=0
if git diff --cached --name-only | grep -q '^voxEx\.html$'; then
  echo "[pre-commit] voxEx.html staged - running syntax + parity gates..."
  node tools/syntax-check.mjs voxEx.html || fail=1
  node tools/parity-check.mjs voxEx.html || fail=1
  # Terrain smoke test (1 seed, ~30s). Full rule: 3 seeds before release.
  if [ -z "$VOXEX_SKIP_TERRAIN" ]; then
    node tools/terrain-node-checks.mjs voxEx.html pre-commit-seed || fail=1
  fi
fi
if [ "$fail" -ne 0 ]; then
  echo ""
  echo "[pre-commit] GATES FAILED - commit blocked."
  echo "[pre-commit] Fix the failures (or --no-verify only if you are CERTAIN the checker is stale)."
  exit 1
fi
exit 0
